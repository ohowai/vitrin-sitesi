<% const activeAdminNav = 'sifre'; %>
<%- include('../partials/admin-head', { title, username, activeAdminNav, csrfToken }) %>

<div class="admin-header">
  <div>
    <h1>Şifre değiştir</h1>
    <p class="sub">Admin hesabınızın şifresini güncelleyin.</p>
  </div>
</div>

<% if (success) { %>
  <div class="alert alert-success">Şifreniz başarıyla güncellendi.</div>
<% } %>
<% if (errors && errors.length) { %>
  <div class="alert alert-error"><ul><% errors.forEach(function(e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<div class="panel" style="padding:26px; max-width:440px;">
  <form method="post" action="/admin/sifre-degistir">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="current_password">Mevcut şifre</label>
      <input type="password" id="current_password" name="current_password" required autocomplete="current-password">
    </div>
    <div class="field">
      <label for="new_password">Yeni şifre (en az 8 karakter)</label>
      <input type="password" id="new_password" name="new_password" minlength="8" required autocomplete="new-password">
    </div>
    <div class="field">
      <label for="new_password_confirm">Yeni şifre (tekrar)</label>
      <input type="password" id="new_password_confirm" name="new_password_confirm" minlength="8" required autocomplete="new-password">
    </div>
    <button type="submit" class="btn btn-solid" style="width:100%;">Şifreyi güncelle</button>
  </form>
</div>

<%- include('../partials/admin-foot') %>
